PORT=3000
# Use the direct TCP port from `npx prisma dev` (51214), not the
# prisma+postgres:// proxy URL on 51213 — this project uses
# @prisma/adapter-pg, which speaks the raw Postgres wire protocol.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
NODE_ENV=development
JWT_SECRET="replace_with_a_secure_random_string"
JWT_EXPIRES_IN="1d"

# Test Database configuration (used by run-tests.sh)
# The test harness spins up a temporary PostgreSQL instance on port 5434.
# TEST_DATABASE_URL="postgresql://testuser:testpassword@localhost:5434/testdb"